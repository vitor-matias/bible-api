{
  "name": "bible-api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "test:coverage": "tsc --sourceMap && mkdir -p coverage && node --test --enable-source-maps --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"dist/**/*.test.js\"",
    "start": "tsc && node dist/index.js",
    "import": "tsc && node dist/import.js",
    "biome": "npx @biomejs/biome check --write ./src"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.3.0",
    "redis": "^5.10.0",
    "usfm-js": "^3.4.3",
    "voyageai": "^0.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
