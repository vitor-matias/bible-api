{
    "compilerOptions": {
      "target": "ES6",
      // Node 18+ runtime: type against a modern standard library even though
      // the emitted syntax stays ES6.
      "lib": ["ES2022"],
      "module": "commonjs",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "outDir": "./dist",
      "typeRoots": ["./src/@types", "./node_modules/@types"],
      "noImplicitAny": true,
    },
    "include": ["src/**/*"]
  }
  