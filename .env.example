# Copy to .env and fill in. See README.md for what each one does.

# Any Redis-compatible server (Redis, Valkey, Redis Stack). Use rediss:// for TLS.
DB_URL=redis://localhost:6379

# Folder of USFM files. Needed to import the Bible; not needed just to serve it.
PATH_TO_TEXTS=../portuguese-capuchine-translation/usfm-notes-intro/

# Embeddings for every verse (at import) and every semantic query.
OPENAI_API_KEY=

# Vector size (8 to 3072). Changing it needs a reimport.
# EMBEDDING_DIMENSIONS=512

# PORT=3000
# TRUST_PROXY=1
# CORS_ORIGIN=https://example.org
