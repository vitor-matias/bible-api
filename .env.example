# Copy to .env (read from the working directory at start) and fill in.

PORT=3000
# Redis Stack (RedisJSON + RediSearch). The Bible data lives in this URL's
# database, which a reimport flushes; +365 reminders use the next database
# along (/0 -> /1), which it never touches.
DB_URL=redis://localhost:6379
PATH_TO_TEXTS=/path/to/usfm/texts
VOYAGE_API_KEY=
# CORS_ORIGIN=https://example.com,https://www.example.com
# TRUST_PROXY=1

# +365 Web Push reminders. Without all three, the reminder routes answer 503
# and nothing is sent. Generate the key pair once with
#   npx web-push generate-vapid-keys
# and keep it: changing it invalidates every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact the push services can reach.
VAPID_SUBJECT=mailto:you@example.com
